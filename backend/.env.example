# ──────────────────────────────────────────────────────────────
# CAMPO DIGITAL — Backend do SabIA, Inteligência do Território
# ──────────────────────────────────────────────────────────────
# 1. Copie este arquivo para .env:   cp .env.example .env
# 2. Preencha GEMINI_API_KEY com sua chave real
# 3. NUNCA suba o arquivo .env para o GitHub (já está no .gitignore)
# ──────────────────────────────────────────────────────────────

# Chave da API Google Gemini
# Obtenha gratuitamente em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=COLOQUE_SUA_CHAVE_AQUI

# Porta do servidor (padrão: 3001)
PORT=3001

# Modelo Gemini econômico definido pela equipe
GEMINI_MODEL=gemini-2.5-flash-lite

# Máximo de tokens por resposta
MAX_TOKENS=1000

# Limites aprovados para permanecer no plano gratuito
RATE_LIMIT_PER_IP_MIN=30
RATE_LIMIT_GLOBAL_MIN=15
RATE_LIMIT_GLOBAL_DAY=200

# Proteção persistente — obtenha estes valores na integração Upstash da Vercel
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# A integração Vercel também pode criar estes nomes:
# UPSTASH_REDIS_REST_KV_REST_API_URL=
# UPSTASH_REDIS_REST_KV_REST_API_TOKEN=
REQUIRE_PERSISTENT_RATE_LIMIT=false

# Segredo aleatório usado apenas para anonimizar o IP nos contadores
RATE_LIMIT_SALT=SUBSTITUA_POR_UM_VALOR_ALEATORIO_LONGO
RATE_LIMIT_PREFIX=campo-digital

# Origens permitidas (CORS) — separadas por vírgula
# Para deploy: adicione a URL pública do seu site
# Exemplo: ALLOWED_ORIGINS=http://localhost,https://seuprojeto.github.io
ALLOWED_ORIGINS=https://fabcampo.com.br,https://www.fabcampo.com.br,http://localhost,http://127.0.0.1,null
